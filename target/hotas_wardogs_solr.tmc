// =============================================================================
//  WARDOGS  -  Thrustmaster Sol-R [R] Flightstick + Sol-R 6 Throttle
//  T.A.R.G.E.T. script, driven live by the Sol-R Curves app (solr-curves).
//
//  Roll, pitch, yaw and the throttle are shaped by lookup tables that the app writes to
//  C:/SolR/hotas_curves.txt. The script re-reads that file every 250 ms while it
//  runs, so a change in the app reaches the game within a quarter second,
//  without restarting the script or WARDOGS. After loading a table it writes
//  its number to C:/SolR/hotas_curves.ack, which is how the app knows it landed.
//
//  No table file yet: the built-in default is used (S-curve +2, 2% centre
//  deadzone on roll and pitch, 3% on yaw - the tuned profile).
//
//  The Sol-R 6 Throttle (needs T.A.R.G.E.T. 3.0.25.603 or later) joins in:
//  its lever through the fourth table onto the Z axis, its buttons and hats
//  onto DX45..DX62 - clear of the stick's DX1..DX44 and its POV hat, which
//  T.A.R.G.E.T.'s default map would otherwise hand the throttle too.
//  Both appear in the game as ONE device, "Thrustmaster Combined".
//  Start this script BEFORE WARDOGS.
// =============================================================================
include "target.tmh"

alias CFG   = "C:/SolR/hotas_curves.txt";
alias ACK   = "C:/SolR/hotas_curves.ack";
alias RMODE = "rb";
alias WMODE = "wb";

// Table layout: 4 axes (roll, pitch, yaw, throttle) x 257 samples over -100%..+100%.
// File: <gen> <1028 values, -32767..32767> <gen> #<log line>. The repeated
// <gen> proves the file was read whole, not halfway through a write. The log
// line after '#' is written by the app (T.A.R.G.E.T. has no clock of its own):
// date, time and what changed, printed as-is when the table loads.
define NSAMP   257
define NTAB    1028
define POLL_ID 20000			// AutoRepeat handler id, clear of target.tmh's

int crv[1028];					// live tables
int nxt[1028];					// staging while reading
int gen = -1;					// table number currently loaded (-1 = built-in)

// Sol-R 6 Throttle buttons and hats -> DX45..DX62, after the stick's 44
int SolR6Map[] = {TBTN1,DX45, TBTN2,DX46, TBTN3,DX47, TBTN4,DX48, TBTN5,DX49, TBTN6,DX50,
                     THAT1U,DX51, THAT1R,DX52, THAT1D,DX53, THAT1L,DX54,
                     THAT3U,DX55, THAT3R,DX56, THAT3D,DX57, THAT3L,DX58,
                     THAT2U,DX59, THAT2R,DX60, THAT2D,DX61, THAT2L,DX62};
int rv;							// NextInt() result
int note[200];					// the app's log line for the table being loaded
int notelen;

int main()
{
	// Init() looks for every Thrustmaster device it knows and waits on each
	// missing one. Skip them all except the Sol-R [R] Flightstick (Sol_SolR)
	// and the Sol-R 6 Throttle (Sol_Throttle).
	Configure(&Throttle, MODE_EXCLUDED); Configure(&Joystick, MODE_EXCLUDED); Configure(&JoystickF18, MODE_EXCLUDED); Configure(&LMFD, MODE_EXCLUDED);
	Configure(&RMFD, MODE_EXCLUDED); Configure(&HCougar, MODE_EXCLUDED); Configure(&T16000, MODE_EXCLUDED); Configure(&T16000L, MODE_EXCLUDED);
	Configure(&TWCSThrottle, MODE_EXCLUDED); Configure(&TFRPRudder, MODE_EXCLUDED); Configure(&TFRPHARudder, MODE_EXCLUDED); Configure(&A320Pilot, MODE_EXCLUDED);
	Configure(&A320Copilot, MODE_EXCLUDED); Configure(&TCAQuadrant12, MODE_EXCLUDED); Configure(&TCAQuadrant34, MODE_EXCLUDED); Configure(&TCAQBoeing12, MODE_EXCLUDED);
	Configure(&TCAQBoeing34, MODE_EXCLUDED); Configure(&TCAYokeBoeing, MODE_EXCLUDED); Configure(&ViperTQS, MODE_EXCLUDED); Configure(&ViperBBox, MODE_EXCLUDED);
	Configure(&TCASidestickXPilot, MODE_EXCLUDED); Configure(&TCASidestickXCopilot, MODE_EXCLUDED); Configure(&FarmStickRight, MODE_EXCLUDED); Configure(&FarmStickLeft, MODE_EXCLUDED);
	Configure(&AVA_F16, MODE_EXCLUDED); Configure(&AVA_F16L, MODE_EXCLUDED); Configure(&AVA_F18, MODE_EXCLUDED); Configure(&AVA_F18L, MODE_EXCLUDED);
	Configure(&AVA_SolR, MODE_EXCLUDED); Configure(&AVA_SolRL, MODE_EXCLUDED); Configure(&Sol_F16, MODE_EXCLUDED); Configure(&Sol_F16L, MODE_EXCLUDED);
	Configure(&Sol_F18, MODE_EXCLUDED); Configure(&Sol_F18L, MODE_EXCLUDED); Configure(&Sol_SolRL, MODE_EXCLUDED); Configure(&FarmStickXboxRight, MODE_EXCLUDED);
	Configure(&FarmStickXboxLeft, MODE_EXCLUDED);
	// added by T.A.R.G.E.T. 3.0.26: not here either
	Configure(&AVA_Airbus, MODE_EXCLUDED); Configure(&AVA_AirbusL, MODE_EXCLUDED); Configure(&Sol_Airbus, MODE_EXCLUDED); Configure(&Sol_AirbusL, MODE_EXCLUDED);
	Configure(&FarmStickPSLeft, MODE_EXCLUDED); Configure(&FarmStickPSRight, MODE_EXCLUDED);

	if(Init(&EventHandle)) return 1;

	// Roll, pitch, yaw and the throttle lever are NOT MapAxis'd: EventHandle
	// drives them from the tables. The rest pass straight through.
	MapAxis(&Sol_SolR, MS_LR,    DX_XROT_AXIS,     AXIS_NORMAL, MAP_ABSOLUTE);	// look left/right
	MapAxis(&Sol_SolR, MS_UD,    DX_YROT_AXIS,     AXIS_NORMAL, MAP_ABSOLUTE);	// look up/down
	// the stick base's own little lever, SLIDER0 and DIAL go nowhere: their
	// Combined axes belong to the throttle now
	MapAxis(&Sol_Throttle, TROCKER, DX_SLIDER_AXIS,   AXIS_NORMAL, MAP_ABSOLUTE);	// throttle rudder twist
	MapAxis(&Sol_Throttle, TANT,    DX_THROTTLE_AXIS, AXIS_NORMAL, MAP_ABSOLUTE);	// throttle thumbwheel
	// stick buttons + hat: target.tmh maps them 1:1 (DX1..DX44, hat -> POV).
	// throttle: moved to DX45..DX62 (its hat becomes 4 buttons - one POV only)
	MapList(&Sol_Throttle, &SolR6Map);

	// built-in default, computed with T.A.R.G.E.T.'s own S-curve function
	int i = 0;
	float x;
	while(i < NSAMP)
	{
		x = i / 128.0 - 1;
		crv[i]         = AMAX * fcurve(x, 0, 0.02, 0, 0, 2);	// roll
		crv[NSAMP+i]   = AMAX * fcurve(x, 0, 0.02, 0, 0, 2);	// pitch
		crv[2*NSAMP+i] = AMAX * fcurve(x, 0, 0.03, 0, 0, 2);	// yaw
		crv[3*NSAMP+i] = AMAX * x;								// throttle: straight
		i = i + 1;
	}

	printf("\xa*** Sol-R Curves: watching C:/SolR/hotas_curves.txt\xa");
	Poll(0);
	if(gen < 0) printf("*** no table file yet - using the built-in S-curve\xa");
	Refresh();
	AutoRepeat(POLL_ID, 250, &Poll, 0);
}

// Stick value -> shaped value, linear between the two nearest samples.
int Shape(int a, int raw)
{
	float p = (raw + AMAX) * 128.0 / AMAX;		// 0 .. 256
	int i = p;
	if(i < 0) i = 0;
	if(i > NSAMP-2) i = NSAMP-2;
	float f = p - i;
	int b = a*NSAMP + i;
	return crv[b] + (crv[b+1] - crv[b]) * f;
}

// Push the current stick position through the tables (after a reload, so a
// stick held still does not keep the old value until it moves).
int Refresh()
{
	DXAxis(DX_X_AXIS,    Shape(0, Sol_SolR[JOYX]));
	DXAxis(DX_Y_AXIS,    Shape(1, Sol_SolR[JOYY]));
	DXAxis(DX_ZROT_AXIS, Shape(2, Sol_SolR[ROCKER]));
	DXAxis(DX_Z_AXIS,    Shape(3, Sol_Throttle[TTHR]));
}

// Next integer from the file into rv. 0 at end of file.
int NextInt(int fp)
{
	int c = fgetc(fp);
	while((c != -1) & (c != '-') & ((c < '0') | (c > '9'))) c = fgetc(fp);
	if(c == -1) return 0;
	int neg = 0;
	if(c == '-')
	{
		neg = 1;
		c = fgetc(fp);
	}
	rv = 0;
	while((c >= '0') & (c <= '9'))
	{
		rv = rv*10 + c - '0';
		c = fgetc(fp);
	}
	if(neg) rv = -rv;
	return 1;
}

int Poll(int p)
{
	int fp = fopen(&CFG, &RMODE);
	if(!fp) return 0;
	if(!NextInt(fp))
	{
		fclose(fp);
		return 0;
	}
	if(rv == gen)					// unchanged: one number read, done
	{
		fclose(fp);
		return 0;
	}
	int g = rv;
	int n = 0;
	int more = 1;
	while(more & (n < NTAB))
	{
		more = NextInt(fp);
		if(more)
		{
			nxt[n] = rv;
			n = n + 1;
		}
	}
	int ok = 0;
	if(n == NTAB) if(NextInt(fp)) if(rv == g) ok = 1;
	if(ok) ReadNote(fp);
	fclose(fp);
	if(!ok) return 0;				// caught mid-write: try again next poll

	n = 0;
	while(n < NTAB)
	{
		crv[n] = nxt[n];
		n = n + 1;
	}
	gen = g;
	Refresh();
	Ack();
	PrintNote(g);
}

// The rest of the line after '#', up to 199 characters.
int ReadNote(int fp)
{
	notelen = 0;
	int c = fgetc(fp);
	while((c != -1) & (c != '#')) c = fgetc(fp);
	if(c == -1) return 0;
	c = fgetc(fp);
	while((c != -1) & (c != 13) & (c != 10) & (notelen < 199))
	{
		note[notelen] = c;
		notelen = notelen + 1;
		c = fgetc(fp);
	}
}

// "19 Sep 2026  01:23:45  |  Roll right: deadzone 2 -> 3  |  #898010556"
int PrintNote(int g)
{
	int i = 0;
	if(!notelen)
	{
		printf("curves loaded #%d\xa", g);
		return 0;
	}
	while(i < notelen)
	{
		putchar(note[i]);
		i = i + 1;
	}
	printf("  |  #%d\xa", g);
}

// Tell the app which table is live.
int Ack()
{
	char t; Dim(&t, 32);
	sprintf(&t, "%d", gen);
	int fp = fopen(&ACK, &WMODE);
	if(!fp) return 0;
	fwrite(&t, 1, strlen(&t), fp);
	fclose(fp);
}

int EventHandle(int type, alias o, int x)
{
	if(&o == &Sol_SolR)
	{
		if(x == JOYX)
		{
			DXAxis(DX_X_AXIS, Shape(0, o[x]));
			return 0;
		}
		if(x == JOYY)
		{
			DXAxis(DX_Y_AXIS, Shape(1, o[x]));
			return 0;
		}
		if(x == ROCKER)
		{
			DXAxis(DX_ZROT_AXIS, Shape(2, o[x]));
			return 0;
		}
	}
	if(&o == &Sol_Throttle)
	{
		if(x == TTHR)
		{
			DXAxis(DX_Z_AXIS, Shape(3, o[x]));
			return 0;
		}
	}
	DefaultMapping(&o, x);
}
