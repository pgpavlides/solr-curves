{
  "name": "wardogspilot",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "tiles": "node scripts/tile-server.mjs",
    "build": "next build",
    "start": "npx serve out",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "prebuild": "node -e \"require('fs').rmSync('out',{recursive:true,force:true})\"",
    "clean": "node -e \"for(const d of ['.next','.next-build','out'])require('fs').rmSync(d,{recursive:true,force:true})\""
  },
  "dependencies": {
    "@react-three/drei": "^10.0.0",
    "@react-three/fiber": "^9.0.0",
    "leaflet": "^1.9.4",
    "next": "^15.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-leaflet": "^5.0.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.180.0",
    "typescript": "^5.6.0"
  }
}
