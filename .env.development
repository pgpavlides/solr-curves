# Dev uses the same public tiles as production, so what you see locally is what
# ships. To work offline, create .env.local (gitignored) with
# NEXT_PUBLIC_TILE_BASE=http://localhost:8788 and run `npm run tiles` — but
# remember .env.local also overrides .env.production, so move it aside before a
# deploy build. scripts/check-tile-base.mjs will stop you if you forget.
NEXT_PUBLIC_TILE_BASE=https://tiles.wardogspilot.com
