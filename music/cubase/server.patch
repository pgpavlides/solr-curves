+def press(name: str) -> bool:
+    """Trigger a Cubase key command through the Wardogs ClaudeBridge MIDI Remote script."""
+    cc = remote.command_cc(name)
+    ch = remote.COMMAND_CHANNEL
+    return send_midi_cc(cc, 127, ch) and send_midi_cc(cc, 0, ch)
+
+
+@mcp.tool(description=(
+    "Run a Cubase key command. Commands that open a dialog (import_midi_file, "
+    "export_audio_mixdown) still need the user to finish the dialog. "
+    f"name is one of: {', '.join(remote.COMMAND_NAMES)}"))
+def cubase_command(name: str) -> str:
+    if name not in remote.COMMAND_NAMES:
+        return f"✗ Unknown command '{name}'. Available: {', '.join(remote.COMMAND_NAMES)}"
+    if press(name):
+        return f"✓ Sent {name}"
+    return f"✗ Failed to send {name}"
+
