---
interface Props {
  eyebrow: string;
  title: string;
  lede?: string;
}
const { eyebrow, title, lede } = Astro.props;
---

<div class="section-head">
  <div>
    <span class="section-eyebrow">— {eyebrow}</span>
    <h2>{title}</h2>
  </div>
  {lede && <p class="lede" set:html={lede} />}
</div>
