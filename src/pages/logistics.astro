---
import Base from "../layouts/Base.astro";
import PageHead from "../components/PageHead.astro";
import SectionHead from "../components/SectionHead.astro";
import Callout from "../components/Callout.astro";
import Table from "../components/Table.astro";
import { supplies, habits } from "../data/supplies";
import { payouts } from "../data/numbers";
---

<Base
  title="Logistics and the pilot economy"
  description="WARDOGS supply runs: what each supply type feeds, pallets versus boxes, the opening-FOB markup trap, hot-zone payouts and the habits that make you worth flying with."
>
  <PageHead
    eyebrow="The other half of the job"
    title="Logistics."
    lede="Moving troops is the obvious pilot job. Running supplies is the one that decides matches — WARDOGS is not scored on kills, it is scored on keeping people in the circle and the bases fed. It is also steadier money, because nobody shoots at you on the way to a rear FOB."
  />

  <section class="section">
    <SectionHead
      eyebrow="Opening minutes"
      title="Grab a FOB and a hammer."
      lede="Games spawn several towers — five is common — and each one your team holds gives an extra code toward dragging the zone your way."
    />
    <div class="prose">
      <p>
        Everyone rushes the nearest tower, so a pilot who runs a load to a
        <em>second</em>, uncontested tower hands the team a real advantage. Listen
        on comms first: if no other pilot has called it, take a
        <strong>FOB and a large building hammer</strong>, because nothing gets
        built without them, then fill the remaining space with ammo and build
        supplies so the trip is not wasted.
      </p>
    </div>

    <Callout label="Turn your markup off for the opening FOB" critical>
      <p>
        A FOB is roughly <strong>$2,500</strong> base. Leave the default
        <strong>25% markup</strong> on and you are charging a teammate an extra
        ~$625 in the first two minutes of the round, which nobody will pay and
        which stalls your own team's build.
      </p>
      <p>
        Set the margin to zero on the first FOB drop, then put it back for routine
        runs. The setting does not remember your preference between crates, so
        check it every time.
      </p>
    </Callout>
  </section>

  <section class="section">
    <SectionHead
      eyebrow="Cargo"
      title="What each supply type actually does."
      lede="Hover a FOB on the map and it shows what it is holding and what it is short of. Do this on every flight home, and re-check on the way out — needs change fast, and it is worth diverting mid-flight."
    />

    <Table>
      <table>
        <thead>
          <tr><th>Supply</th><th>Feeds</th><th>When it is in demand</th></tr>
        </thead>
        <tbody>
          {
            supplies.map((s) => (
              <tr>
                <td><b>{s.supply}</b></td>
                <td>{s.feeds}</td>
                <td>{s.demand}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </Table>

    <div class="grid grid-2 spaced">
      <Callout label="Pallets over boxes">
        <p>
          A <strong>pallet</strong> unloads straight into the FOB the moment you
          set it down in range. A <strong>supply box</strong> has to be
          hand-carried in, limited by inventory slots, which means someone on the
          ground makes several trips under fire. Take pallets wherever you can.
        </p>
      </Callout>
      <Callout label="Where the drops go">
        <p>
          Building supplies go <em>inside</em> the FOB zone so they unpack. Ammo
          and meds go to troops actually in contact — watch the minimap for where
          your team is dying, since those are the people who will pay a markup
          without complaining. Around <strong>25%</strong> is the sweet spot on
          routine runs.
        </p>
      </Callout>
    </div>
  </section>

  <section class="section">
    <SectionHead
      eyebrow="Getting paid"
      title="The money comes from what your passengers do next."
    />

    <div class="grid grid-2">
      <article class="card is-featured">
        <span class="card-eyebrow">Payouts</span>
        <ul class="tight">
          {payouts.map((p) => <li set:html={p} />)}
        </ul>
      </article>

      <div class="stack-tight">
        <Callout label="The multiplier" critical>
          <p>
            The <strong>hot zone pays 2×</strong> on every action performed inside
            it, passenger drops included. Land your troops <em>in</em> the zone
            rather than safely outside it and the same run is worth double. One
            documented run went from −$6,000 to +$900 on a single drop, and
            +$2,400 on another.
          </p>
        </Callout>

        <article class="card">
          <span class="card-eyebrow">Parachutes</span>
          <p class="card-body">
            Buy them for your passengers from the vendor; the panel bottom-right
            shows who is carrying one. If <em>everybody</em> aboard has a chute you
            can overfly the point and have them step off, which is far safer than
            landing. Tell people how to equip: <kbd>F</kbd>, scroll to inventory,
            select the parachute.
          </p>
        </article>
      </div>
    </div>
  </section>

  <section class="section">
    <SectionHead
      eyebrow="Etiquette"
      title="Habits that make you worth flying with."
    />
    <div class="prose">
      <ul>
        {habits.map((h) => <li set:html={h} />)}
      </ul>
      <p>
        Buy body armour and a helmet before you take off. You are an infantryman
        the moment you are shot down, and having a kit means a crash costs you an
        airframe instead of the whole round.
      </p>
    </div>
  </section>

  <nav class="pager" aria-label="Next">
    <a class="btn btn-secondary" href="/numbers/">Next: the numbers</a>
  </nav>
</Base>

<style>
  .spaced { margin-top: var(--space-lg); }
  .card .card-eyebrow { display: block; }
  ul.tight {
    color: var(--color-muted);
    line-height: 1.6;
    padding-left: 20px;
    margin: var(--space-sm) 0 0;
    font-size: var(--text-body-sm);
  }
  ul.tight li { margin-bottom: var(--space-xs); }
  ul.tight li::marker { color: var(--color-hairline); }
  .tight :global(strong) { color: var(--color-foreground); font-weight: var(--weight-semibold); }
  .stack-tight > * + * { margin-top: var(--space-md); }
  .pager { display: flex; justify-content: flex-end; padding-top: var(--space-lg); }
</style>
