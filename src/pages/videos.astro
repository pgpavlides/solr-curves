---
import Base from "../layouts/Base.astro";
import PageHead from "../components/PageHead.astro";
import Callout from "../components/Callout.astro";
import { videos, url } from "../data/videos";
import { transcriptCount } from "../data/meta";

const read = videos.filter((v) => v.transcribed);
const unread = videos.filter((v) => !v.transcribed);
---

<Base
  title="Source videos"
  description="Every WARDOGS helicopter tutorial used to build this reference, with channel, length and what each one covers."
>
  <PageHead
    eyebrow="Sourcing"
    title="Source"
    accent="videos."
    lede={`Captions were pulled from ${transcriptCount} of these and read in full. Where two creators disagreed, the disagreement is stated on the relevant page rather than smoothed over.`}
  />

  <Callout label="A warning about the &ldquo;wiki&rdquo; sites" critical>
    <p>
      Search for WARDOGS helicopter guides and you will hit a cluster of
      near-identical sites — wardogswiki.com, thewardogs.wiki, wardogsguide.wiki,
      wardogshub.gg, wardogsguides.com — that are generated SEO content,
      contradict each other, and cite named settings
      (&ldquo;Stability Assist&rdquo;, &ldquo;Envelope Limits&rdquo;,
      &ldquo;Turn Coordination&rdquo;) that appear in no gameplay footage. None of
      them were used here.
    </p>
  </Callout>

  <section class="section">
    <h2 class="list-head">Read in full</h2>
    <ul class="sources">
      {
        read.map((v) => (
          <li>
            <span class="chan">{v.channel}</span>
            <a class="title" href={url(v.id)} rel="noopener">
              {v.title}
              <span class="chip">{v.covers}</span>
            </a>
            <span class="len">{v.length}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="section">
    <h2 class="list-head">Indexed, not transcribed</h2>
    <p class="list-note">
      No captions available, or gameplay rather than instruction. Listed so the
      index is complete — nothing on this site is sourced from them.
    </p>
    <ul class="sources">
      {
        unread.map((v) => (
          <li>
            <span class="chan">{v.channel}</span>
            <a class="title" href={url(v.id)} rel="noopener">
              {v.title}
              <span class="chip">{v.covers}</span>
            </a>
            <span class="len">{v.length}</span>
          </li>
        ))
      }
    </ul>
  </section>
</Base>

<style>
  .list-head {
    font-family: var(--font-display);
    font-size: var(--text-display-sm);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-tight);
    color: var(--color-foreground);
    margin: 0 0 var(--space-md);
  }
  .list-note {
    color: var(--color-muted);
    font-size: var(--text-body-sm);
    max-width: 62ch;
    margin: 0 0 var(--space-md);
  }
  .sources .chip { margin-left: var(--space-xs); }
</style>
